generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Gender {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model Citizenship {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model Nationality {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model Position {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees       Employee[]
  workExperiences WorkExperience[]
}

model EmploymentType {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model EducationLevel {
  id   Int    @id @default(autoincrement())
  name String @unique

  educations Education[]
}

model MaritalStatus {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model DriverLicenseCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Account {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  role       Role
  firstName  String
  lastName   String
  middleName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee      Employee?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  accountId Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Employee {
  id Int @id @default(autoincrement())

  accountId Int     @unique
  account   Account @relation(fields: [accountId], references: [id])

  birthDate DateTime

  pinfl          String @unique
  passportSeries String
  passportNumber String
  passportExpireDate DateTime
  passportIssuedBy   String

  phone   String
  address String

  // Employment
  employeeNumber String @unique
  hireDate       DateTime?
  formStep       Int      @default(0)

  totalExperienceMonths         Int @default(0)
  specialtyExperienceMonths    Int?

  // Additional
  militaryService  Boolean @default(false)
  hasDriverLicense Boolean @default(false)
  additionalInfo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean  @default(false)

  // Foreign keys
  genderId                   Int
  citizenshipId              Int
  nationalityId              Int
  departmentId              Int?
  positionId                 Int?
  employmentTypeId          Int?
  maritalStatusId           Int
  driverLicenseCategoryId   Int?

  // Relationships
  gender Gender @relation(fields: [genderId], references: [id])
  citizenship Citizenship @relation(fields: [citizenshipId], references: [id])
  nationality Nationality @relation(fields: [nationalityId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  maritalStatus MaritalStatus @relation(fields: [maritalStatusId], references: [id])
  driverLicenseCategory DriverLicenseCategory? @relation(fields: [driverLicenseCategoryId], references: [id])

  relatives       Relative[]
  workExperiences WorkExperience[]
  educations      Education[]
}

model Education {
  id Int @id @default(autoincrement())

  employeeId       Int
  educationLevelId Int

  institution    String
  specialty      String
  graduationYear Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean  @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id])
}

model Relative {
  id Int @id @default(autoincrement())

  employeeId Int

  fullName     String
  relationship String
  birthDate    DateTime?
  phone        String?
  workplace    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean  @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id Int @id @default(autoincrement())

  employeeId Int
  positionId Int

  companyName      String
  startDate        DateTime
  endDate          DateTime?
  responsibilities String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
  isDeleted Boolean  @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id])
}
